# Variáveis de produção para a stack do Portainer.
# Copie para vps.env (ignorado pelo git), preencha e use "Load variables from .env file".
# As credenciais de OpenAI, SMTP e Telegram NÃO ficam aqui: são cadastradas dentro do
# n8n (Credentials) e armazenadas criptografadas com N8N_ENCRYPTION_KEY.

DOMINIO=aiops.gustavomartins.dev
TZ=America/Sao_Paulo

# Versão do n8n testada com estes workflows (fixe a versão em vez de usar "latest")
N8N_VERSION=2.45.5

# Segredos: gere com `openssl rand -hex 24`
POSTGRES_PASSWORD=troque-me
OPS_APP_PASSWORD=troque-me
OPS_MEMORIA_PASSWORD=troque-me
N8N_ENCRYPTION_KEY=troque-me

# Quem recebe os pedidos de aprovação e os alertas de SLA (chat_id do Telegram)
APROVADOR_TELEGRAM_CHAT_ID=
GESTOR_TELEGRAM_CHAT_ID=

# Remetente dos e-mails enviados ao cliente (precisa ser aceito pelo seu SMTP)
EMAIL_REMETENTE=Vértice Cloud Atendimento <atendimento@seudominio.com>
